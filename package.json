{
  "name": "ludoclicker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run lint && npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:scale": "vitest run -c vitest.scale.config.mjs --reporter=default",
    "test:e2e": "node scripts/run-playwright.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "lz-string": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
